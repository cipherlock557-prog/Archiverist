@bot.command()
async def ocpeek(ctx, *, query: str):
    """
    View an OC.

    !ocpeek Nova
    searches your own OC Book.

    !ocpeek @User Nova
    searches another user's OC Book.
    """
    query = query.strip()
    target = ctx.author

    # If a member mention was included, use that member as the owner.
    if ctx.message.mentions:
        target = ctx.message.mentions[0]
        query = re.sub(
            r"<@!?\d+>",
            "",
            query,
            count=1,
        ).strip()

    if not query:
        await ctx.send(
            embed=make_embed(
                "❌ Missing OC Name",
                f"Try `{PREFIX}ocpeek Nova` or "
                f"`{PREFIX}ocpeek @username Nova`.",
                discord.Color.orange(),
            )
        )
        return

    book = get_book(target.id)
    key = normalize_name(query)
    oc = book["ocs"].get(key)

    if oc is None:
        # Friendly partial-name search.
        matches = [
            data
            for data in book["ocs"].values()
            if query.lower() in data["name"].lower()
        ]

        if len(matches) == 1:
            oc = matches[0]
        else:
            await ctx.send(
                embed=make_embed(
                    "🔍 OC Not Found",
                    f"I couldn't find **{query}** in "
                    f"{target.display_name}'s OC Book.\n\n"
                    f"Use `{PREFIX}oclist @{target.display_name}` to browse their characters.",
                    discord.Color.red(),
                )
            )
            return

    await ctx.send(
        embed=build_oc_embed(target, oc),
        view=OCProfileView(
            target,
            ctx.author.id,
            normalize_name(oc["name"]),
        ),
    )


