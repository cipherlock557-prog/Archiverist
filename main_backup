# ============================================================
#
# Each user gets:
#
# {
#   "profile": {
#       "name": "...",
#       "pronouns": "...",
#       "about": "...",
#       "status": "...",
#       "links": "...",
#       "image": "...",       # PFP
#       "banner": "...",      # Banner
#       "color": "#5865F2"
#   },
#   "world": {
#       "name": "...",
#       "genre": "...",
#       "setting": "...",
#       "lore": "...",
#       "rules": "...",
#       "notes": "...",
#       "image": "...",       # Innerworld PFP
#       "banner": "...",      # Innerworld banner
#       "color": "#2B8C85"
#   },
#   "ocs": {
#       "oc-name": {
#           "name": "...",
#           "age": "...",
#           "pronouns": "...",
#           "personality": "...",
#           "appearance": "...",
#           "lore": "...",
#           "likes": "...",
#           "dislikes": "...",
#           "abilities": "...",
#           "relationships": "...",
#           "notes": "...",
#           "image": "...",       # OC PFP
#           "banner": "...",      # OC banner
#           "color": "#5865F2"
#       }
#   }
# }
#
# The JSON file keeps the information after bot restarts.
# ============================================================

def default_book():
    return {
        "profile": {
            "name": "",
            "pronouns": "",
            "about": "",
            "status": "",
            "links": "",
            "image": "",
            "banner": "",
            "color": "#5865F2",
        },
        "world": {
            "name": "",
            "genre": "",
            "setting": "",
            "lore": "",
            "rules": "",
            "notes": "",
            "image": "",
            "banner": "",
            "color": "#2B8C85",
        },
        "ocs": {},
    }


def load_data():
    if not os.path.exists(DATA_FILE):
        return {}

    try:
        with open(DATA_FILE, "r", encoding="utf-8") as file:
            loaded = json.load(file)

        if isinstance(loaded, dict):
            return loaded

    except (json.JSONDecodeError, OSError) as error:
        print(f"⚠️ Could not load {DATA_FILE}: {error}")

    return {}


oc_books = load_data()


async def save_data():
    """Save OC books safely to disk."""
    async with data_lock:
        temp_file = f"{DATA_FILE}.tmp"

        with open(temp_file, "w", encoding="utf-8") as file:
            json.dump(oc_books, file, indent=4, ensure_ascii=False)

        os.replace(temp_file, DATA_FILE)


def get_book(user_id):
    """Get a user's OC book and repair missing sections."""
    key = str(user_id)

    if key not in oc_books:
        oc_books[key] = default_book()

    book = oc_books[key]
    defaults = default_book()

    for section, values in defaults.items():
        if section not in book or not isinstance(book[section], dict):
            book[section] = deepcopy(values)

        if isinstance(values, dict):
            for field, default_value in values.items():
                book[section].setdefault(field, default_value)

    # Older versions already used "image" for the profile/OC picture.
    # Keep that value as the PFP so existing books do not lose their images.
    for oc in book["ocs"].values():
        if isinstance(oc, dict):
            oc.setdefault("banner", "")
            oc.setdefault("color", "#5865F2")
            oc.setdefault("image", "")

    return book


def normalize_name(name):
    """Normalize OC names for searching/storage."""
    return re.sub(r"\s+", " ", name.strip()).lower()


def valid_url(url):
    """Accept normal HTTP(S) image/page URLs."""
    return bool(re.match(r"^https?://", str(url or "").strip(), re.IGNORECASE))


def normalize_hex(value, fallback="#5865F2"):
    """Validate a Discord embed color and return #RRGGBB."""
    value = str(value or "").strip()

    if not value:
        return fallback

    value = value.lstrip("#")

    if re.fullmatch(r"[0-9a-fA-F]{6}", value):
        return f"#{value.upper()}"

    return None


def embed_color(value, fallback=discord.Color.blurple()):
    """Turn a stored hex color into a Discord Color."""
    normalized = normalize_hex(value)

    if normalized is None:
        return fallback

    return discord.Color(int(normalized[1:], 16))


def image_hint(url):
    """Explain that Discord needs a direct image URL."""
    if not url:
        return ""

    return (
        "Images must be direct/public HTTPS image URLs. "
        "On Tumblr/Pinterest/etc., use **Copy Image Address** when possible; "
        "a normal post/pin page URL may not render as an image in Discord."
    )


def clip(text, limit=1024, fallback="Not set."):
    """Discord embed fields have a 1024-character limit."""
    text = str(text or "").strip()

    if not text:
        return fallback

    if len(text) <= limit:
        return text

    return text[: limit - 3] + "..."


def make_embed(title, description="", color=discord.Color.blurple()):
    return discord.Embed(
        title=title,
        description=description,
        color=color,
    )


